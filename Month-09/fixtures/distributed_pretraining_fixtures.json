    "gradient_clipping_norm": 1.0,
    "weight_decay": 0.1
  },
  "benchmark_baselines": {
    "target_mfu_percentage": 48.5,
    "target_tokens_per_sec": 380000,
    "checkpoint_save_latency_sec": 0.85,
    "straggler_tolerance_ratio": 1.5
  }
