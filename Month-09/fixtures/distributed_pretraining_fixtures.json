{
  "cluster_topology": {
    "world_size": 64,
    "nodes": 8,
    "gpus_per_node": 8,
    "interconnect": {
      "intra_node": "NVLink-4 (900 GB/s)",
      "inter_node": "InfiniBand NDR (400 Gb/s)"
    },
    "parallelism_dimensions": {
      "tensor_parallel_size": 8,
      "pipeline_parallel_size": 2,
      "data_parallel_size": 4,
